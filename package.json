{
  "name": "@salve-software/qazinho-harness",
  "version": "0.1.0",
  "private": true,
  "description": "The QA harness QAzinho builds around an agent: what it is told, the tools it gets and the shapes it answers in.",
  "license": "UNLICENSED",
  "author": "Salve Software",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salve-Software/qazinho-harness.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/types/contract/index.d.ts",
      "import": "./dist/contract.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsgo --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md,yml,yaml}": "prettier --write"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^22.20.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
