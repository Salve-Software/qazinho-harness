{
  "name": "@salve-software/qazinho-harness",
  "version": "0.1.0",
  "private": true,
  "description": "QAzinho's agent harness and run engine.",
  "license": "UNLICENSED",
  "author": "Salve Software",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Salve-Software/qazinho-harness.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/types/contract/index.d.ts",
      "import": "./dist/contract.js"
    },
    "./engine": {
      "types": "./dist/types/engine/index.d.ts",
      "import": "./dist/engine.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsgo --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky || true",
    "test:smoke": "vitest run --config tests/vitest.smoke.ts"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md,yml,yaml}": "prettier --write"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.63.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^22.20.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "pdfjs-dist": "6.5.438",
    "playwright-core": "1.65.0",
    "prettier": "^3.10.1",
    "tsc-alias": "^1.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  }
}
